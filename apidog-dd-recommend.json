{
  "info": {
    "_postman_id": "dd-gorse-v1-recommend",
    "name": "Durlabh Darshan – Gorse v1",
    "description": "App-facing BFF in front of local Gorse.\n\nUserId is always auth profile.id (never DD userId).\n\nImport: ApiDog → Import → Postman Collection v2.1 → this file.\nServer: `cd dd-api && node server.mjs` (http://localhost:8090).\n\nSuggested run order in **1. Test flow**.\nCategories: vr360, theatre3d, flat2d, abhishek, temple, live, aarti, blog, reel, sadhana, tirth, bhakti.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://apis.hindusanatanapp.com/gorse" },
    { "key": "baseUrlLocal", "value": "http://localhost:8090" },
    { "key": "profileId", "value": "1" },
    { "key": "n", "value": "10" },
    { "key": "kind", "value": "vr360" },
    { "key": "itemId", "value": "tirth:vr:159" },
    { "key": "templeId", "value": "9" },
    { "key": "liveId", "value": "kashi-vishwanath" },
    { "key": "reelId", "value": "-OdmMLfPs1qNXeEUfRMG" },
    { "key": "blogId", "value": "BE_078" },
    { "key": "abhishekId", "value": "Shri Omkareshwar Jyotirling" },
    { "key": "aartiId", "value": "69e60c21c075d7000163a09b" },
    { "key": "sadhanaId", "value": "stotra-vishnu-sahasranama" },
    { "key": "theatreId", "value": "bhakti:3d:series:14" }
  ],
  "item": [
    {
      "name": "1. Test flow",
      "description": "Run these in order. Expect native ids like tirth:vr:159 — never show:… and never tirth:vr:160.",
      "item": [
        {
          "name": "1. Health",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/v1/health",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "health"]
            },
            "description": "200 when BFF + Gorse are ready. `{ ok: true }`."
          },
          "response": []
        },
        {
          "name": "2. Latest VR (sanity)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/v1/latest?n={{n}}&category=vr360",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "latest"],
              "query": [
                { "key": "n", "value": "{{n}}" },
                { "key": "category", "value": "vr360" }
              ]
            },
            "description": "Cold-start list. First hit should be tirth:vr:159 (or another high VR id). Must not include tirth:vr:160."
          },
          "response": []
        },
        {
          "name": "3. Post watch on VR",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"profileId\": \"{{profileId}}\",\n  \"items\": [\n    {\n      \"kind\": \"vr360\",\n      \"id\": \"{{itemId}}\",\n      \"feedbackType\": \"watch\",\n      \"value\": 8\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/feedback",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "feedback"]
            },
            "description": "Simulates PlaybackSession.end at 80% watched. value is 0–10 (watch>=5 counts as positive). Wait a few seconds, then run step 4. Collaborative ranks may stay latest-like until Gorse workers finish."
          },
          "response": []
        },
        {
          "name": "4. Recommend VR for profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/v1/recommend?profileId={{profileId}}&n={{n}}&category=vr360",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "recommend"],
              "query": [
                { "key": "profileId", "value": "{{profileId}}" },
                { "key": "n", "value": "{{n}}" },
                { "key": "category", "value": "vr360" }
              ]
            },
            "description": "`source` is recommend or latest (fallback). Items are `{ kind, id, score, itemId }`."
          },
          "response": []
        },
        {
          "name": "5. Similar to that VR",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/v1/similar?kind={{kind}}&id={{itemId}}&n={{n}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "similar"],
              "query": [
                { "key": "kind", "value": "{{kind}}" },
                { "key": "id", "value": "{{itemId}}" },
                { "key": "n", "value": "{{n}}" }
              ]
            },
            "description": "Item-to-item neighbors. Empty until Gorse finishes neighbors; retry later."
          },
          "response": []
        },
        {
          "name": "6. Guest recommend (no profileId)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/v1/recommend?n={{n}}&category=vr360",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "recommend"],
              "query": [
                { "key": "n", "value": "{{n}}" },
                { "key": "category", "value": "vr360" },
                { "key": "profileId", "value": "", "disabled": true }
              ]
            },
            "description": "Logged-out path. Omits profileId so the BFF returns `{ source: \"latest\" }`."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Catalog sync",
      "item": [
        {
          "name": "POST sync catalog",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/v1/sync",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "sync"]
            },
            "description": "Pulls CDN + Firebase reels + gateway aarti + sadhana into Gorse. Slow (~10s). Already synced if latest VR works. Expect ~811 items; reel > 0; live ~6; no errors."
          },
          "response": []
        }
      ]
    },
