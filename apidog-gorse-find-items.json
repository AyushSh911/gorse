{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Gorse – Find Items",
    "description": "Local Gorse recommender endpoints for finding items.\n\nBase URL: http://localhost:8087 (gorse-server)\nDashboard: http://localhost:8088\n\nImport into ApiDog: File → Import → this JSON (Postman Collection v2.1).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8087"
    },
    {
      "key": "userId",
      "value": "bob"
    },
    {
      "key": "itemId",
      "value": "ollama:ollama"
    },
    {
      "key": "category",
      "value": "python"
    },
    {
      "key": "n",
      "value": "10"
    },
    {
      "key": "apiKey",
      "value": ""
    }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Recommend for user",
      "item": [
        {
          "name": "GET recommend by user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/recommend/{{userId}}?n={{n}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "recommend", "{{userId}}"],
              "query": [
                {
                  "key": "n",
                  "value": "{{n}}",
                  "description": "Number of items to return"
                },
                {
                  "key": "offset",
                  "value": "0",
                  "disabled": true
                },
                {
                  "key": "category",
                  "value": "{{category}}",
                  "description": "Filter by category",
                  "disabled": true
                },
                {
                  "key": "write-back-type",
                  "value": "read",
                  "description": "Auto-write read feedback",
                  "disabled": true
                },
                {
                  "key": "write-back-delay",
                  "value": "10m",
                  "disabled": true
                }
              ]
            },
            "description": "Main personalized recommendation. Returns an array of item IDs."
          },
          "response": []
        },
        {
          "name": "GET collaborative filtering",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/collaborative-filtering/{{userId}}?n={{n}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "collaborative-filtering", "{{userId}}"],
              "query": [
                {
                  "key": "n",
                  "value": "{{n}}"
                },
                {
                  "key": "offset",
                  "value": "0",
                  "disabled": true
                },
                {
                  "key": "category",
                  "value": "{{category}}",
                  "disabled": true
                },
                {
                  "key": "user-id",
                  "value": "{{userId}}",
                  "description": "Hide items already read by this user",
                  "disabled": true
                }
              ]
            },
            "description": "Collaborative-filtering candidates with scores: [{Id, Score}]."
          },
          "response": []
        },
        {
          "name": "POST session recommend",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"FeedbackType\": \"star\",\n    \"UserId\": \"session-user\",\n    \"ItemId\": \"ollama:ollama\",\n    \"Value\": 1,\n    \"Timestamp\": \"2026-09-10T00:00:00Z\"\n  },\n  {\n    \"FeedbackType\": \"star\",\n    \"UserId\": \"session-user\",\n    \"ItemId\": \"huggingface:transformers\",\n    \"Value\": 1,\n    \"Timestamp\": \"2026-09-10T00:01:00Z\"\n  }\n]"
            },
            "url": {
              "raw": "{{baseUrl}}/api/session/recommend?n={{n}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "session", "recommend"],
              "query": [
                {
                  "key": "n",
                  "value": "{{n}}"
                },
                {
                  "key": "offset",
                  "value": "0",
                  "disabled": true
                }
              ]
            },
            "description": "Recommend from in-request feedback (anonymous / session user)."
          },
          "response": []
        }
      ]
    },
    {
